# Секреты намеренно не указаны.
# Заполнять только после отдельного разрешения на тестовое подключение.
BITRIX_WEBHOOK_BASE_URL=
BITRIX_EVENT_TOKEN=
BITRIX_EVENT_DOMAIN=crm.complect.org
BITRIX_PORTAL_URL=https://crm.complect.org
# На первом серверном тесте разрешена только тестовая сделка.
BITRIX_ALLOWED_DEAL_IDS=43528
# Код множественного поля компании «Дополнительные менеджеры MAX».
BITRIX_ADDITIONAL_OBJECT_MANAGERS_FIELD=
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# MAX user_id Екатерины для личных технических ошибок.
MAX_ADMIN_USER_ID=
# Включать только после тестовой привязки сотрудника.
MAX_PRIVATE_DELIVERY_ENABLED=false

# Локальный тестовый журнал. Рабочую базу без отдельного разрешения не создавать.
JOURNAL_PATH=data/test_journal.sqlite3
